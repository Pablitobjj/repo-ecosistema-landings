{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/public/sitemap.xml"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/favicon.png",
      "dest": "/public/favicon.png"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.png"
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/(?:about|nosotros)\\.html$",
      "status": 308,
      "headers": {
        "Location": "/about"
      }
    },
    {
      "src": "^/(?:resources|recursos)\\.html$",
      "status": 308,
      "headers": {
        "Location": "/resources"
      }
    },
    {
      "src": "^/precios\\.html$",
      "status": 308,
      "headers": {
        "Location": "/pricing"
      }
    },
    {
      "src": "^/$",
      "dest": "/public/cultural_brain_index.html"
    },
    {
      "src": "^/about/?$",
      "dest": "/public/cultural_brain_nosotros.html"
    },
    {
      "src": "^/pricing\\.html$",
      "status": 308,
      "headers": {
        "Location": "/pricing"
      }
    },
    {
      "src": "^/pricing/?$",
      "dest": "/public/cultural_brain_precios.html"
    },
    {
      "src": "^/resources/?$",
      "dest": "/public/cultural_brain_resources.html"
    },
    {
      "src": "^/resources/(.*)$",
      "dest": "/public/resources/$1"
    }
  ]
}
