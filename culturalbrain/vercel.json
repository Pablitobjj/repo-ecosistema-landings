{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/public/sitemap.xml"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/favicon.png",
      "dest": "/public/favicon.png"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.png"
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/(?:about|nosotros)\\.html$",
      "status": 308,
      "headers": {
        "Location": "/about"
      }
    },
    {
      "src": "^/(?:resources|recursos)\\.html$",
      "status": 308,
      "headers": {
        "Location": "/resources"
      }
    },
    {
      "src": "^/precios\\.html$",
      "status": 308,
      "headers": {
        "Location": "/pricing"
      }
    },
    {
      "src": "^/$",
      "dest": "/public/cultural_brain_index.html"
    },
    {
      "src": "^/about/?$",
      "dest": "/public/cultural_brain_nosotros.html"
    },
    {
      "src": "^/pricing\\.html$",
      "status": 308,
      "headers": {
        "Location": "/pricing"
      }
    },
    {
      "src": "^/pricing/?$",
      "dest": "/public/cultural_brain_precios.html"
    },
    {
      "src": "^/resources/?$",
      "dest": "/public/cultural_brain_resources.html"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/public/assets/$1"
    },
    {
      "src": "^/research-center/?$",
      "dest": "/public/cb_research_center.html"
    },
    {
      "src": "^/cerebro/?$",
      "dest": "/public/cb_cerebro.html"
    },
    {
      "src": "^/sofia/?$",
      "dest": "/public/cb_sofia.html"
    },
    {
      "src": "^/pulse/?$",
      "dest": "/public/cb_pulse.html"
    },
    {
      "src": "^/research-center\\.html$",
      "status": 308,
      "headers": {
        "Location": "/research-center"
      }
    },
    {
      "src": "^/cerebro\\.html$",
      "status": 308,
      "headers": {
        "Location": "/cerebro"
      }
    },
    {
      "src": "^/sofia\\.html$",
      "status": 308,
      "headers": {
        "Location": "/sofia"
      }
    },
    {
      "src": "^/pulse\\.html$",
      "status": 308,
      "headers": {
        "Location": "/pulse"
      }
    },
    {
      "src": "^/how-it-works/?$",
      "dest": "/public/cb_how_it_works.html"
    },
    {
      "src": "^/how-it-works\\.html$",
      "status": 308,
      "headers": {
        "Location": "/how-it-works"
      }
    },
    {
      "src": "^/demo/?$",
      "dest": "/public/cb_demo.html"
    },
    {
      "src": "^/demo\\.html$",
      "status": 308,
      "headers": {
        "Location": "/demo"
      }
    },
    {
      "src": "^/resources/(.*)$",
      "dest": "/public/resources/$1"
    },
    {
      "src": "^/platform/?$",
      "dest": "/public/cb_platform.html"
    },
    {
      "src": "^/platform\\.html$",
      "status": 308,
      "headers": {
        "Location": "/platform"
      }
    },
    {
      "src": "^/solutions/agencies/?$",
      "dest": "/public/cb_solutions_agencies.html"
    },
    {
      "src": "^/solutions/agencies\\.html$",
      "status": 308,
      "headers": {
        "Location": "/solutions/agencies"
      }
    },
    {
      "src": "^/solutions/brands/?$",
      "dest": "/public/cb_solutions_brands.html"
    },
    {
      "src": "^/solutions/brands\\.html$",
      "status": 308,
      "headers": {
        "Location": "/solutions/brands"
      }
    }
  ]
}
